<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as the day theme: RideSync is dark-only. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/ridesync_background</item>
        <item name="android:navigationBarColor">@color/ridesync_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ridesync_background</item>
        <item name="android:statusBarColor">@color/ridesync_background</item>
        <item name="android:navigationBarColor">@color/ridesync_background</item>
    </style>
</resources>
