<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch screen from these: the app mark on
         the app's near-black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ridesync_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ridesync_background</item>
        <item name="android:statusBarColor">@color/ridesync_background</item>
        <item name="android:navigationBarColor">@color/ridesync_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ridesync_background</item>
        <item name="android:statusBarColor">@color/ridesync_background</item>
        <item name="android:navigationBarColor">@color/ridesync_background</item>
    </style>
</resources>
