rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- User profiles (durable data) ----
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidProfileCreate();
      allow update: if isSignedIn() && isOwner(userId) && isValidProfileUpdate();
      allow delete: if false;
    }

    // ---- Everything else: denied until its milestone adds explicit rules ----
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function profileKeys() {
      return ['uid', 'displayName', 'email', 'photoUrl', 'preferences',
              'createdAt', 'updatedAt'];
    }

    function isValidProfileCreate() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
             && data.keys().hasOnly(profileKeys())
             && data.keys().hasAll(['uid', 'createdAt'])
             && isValidDisplayName(data)
             && isValidEmail(data)
             && isValidPhotoUrl(data)
             && isValidPreferences(data);
    }

    function isValidProfileUpdate() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
             && data.uid == resource.data.uid
             && data.keys().hasOnly(profileKeys())
             && isValidDisplayName(data)
             && isValidEmail(data)
             && isValidPhotoUrl(data)
             && isValidPreferences(data);
    }

    function isValidEmail(data) {
      return !('email' in data.keys())
             || data.email == null
             || (data.email is string && data.email.size() <= 320);
    }

    // Synced rider preferences: the solo ride colour (a palette id) and
    // whether fuel stations show on the map.
    function isValidPreferences(data) {
      return !('preferences' in data.keys())
             || (data.preferences is map
                 && data.preferences.keys().hasOnly(['soloColorId', 'fuelEnabled'])
                 && (!('soloColorId' in data.preferences.keys())
                     || (data.preferences.soloColorId is string
                         && data.preferences.soloColorId.size() <= 32))
                 && (!('fuelEnabled' in data.preferences.keys())
                     || data.preferences.fuelEnabled is bool));
    }

    function isValidDisplayName(data) {
      return !('displayName' in data.keys())
             || data.displayName == null
             || (data.displayName is string && data.displayName.size() <= 40);
    }

    function isValidPhotoUrl(data) {
      return !('photoUrl' in data.keys())
             || data.photoUrl == null
             || (data.photoUrl is string && data.photoUrl.size() <= 2048);
    }
  }
}
