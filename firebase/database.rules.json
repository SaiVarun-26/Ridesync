{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['code','name','hostUid','status','createdAt'])",
          "hostUid": { ".validate": "newData.val() === auth.uid || data.val() === auth.uid" },
          "status": { ".validate": "(newData.val() === 'lobby' || newData.val() === 'choosingMode' || newData.val() === 'planning' || newData.val() === 'initializing' || newData.val() === 'riding' || newData.val() === 'ending' || newData.val() === 'ended') && (newData.val() !== 'riding' || newData.parent().child('mode').val() !== 'guided' || root.child('rooms').child($code).child('route').child('encodedPolyline').exists()) && (newData.val() !== 'ending' || data.val() === 'riding') && (newData.val() !== 'ended' || (data.val() === 'ending' && root.child('rideSummaries').child($code).child('group').exists())) && (data.val() !== 'ended' || newData.val() === 'ended')" },
          "mode": { ".validate": "newData.val() === 'guided' || newData.val() === 'free'" }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChild('uid') && newData.child('uid').val() === $uid",
            "ready": { ".validate": "newData.isBoolean()" },
            "initialized": { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "newData.isBoolean()" }
          }
        },
        "claims": {
          "colors": {
            "$colorId": {
              ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
            }
          }
        },
        "route": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostUid').val() === auth.uid && root.child('rooms').child($code).child('meta').child('mode').val() === 'guided' && root.child('rooms').child($code).child('meta').child('status').val() === 'planning'",
          ".validate": "newData.hasChildren(['destinationName','destinationLatitude','destinationLongitude','encodedPolyline','distanceMeters','durationSeconds'])",
          "destinationName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "destinationLatitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "destinationLongitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "encodedPolyline": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100000" },
          "distanceMeters": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "durationSeconds": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "rideStats": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && root.child('rooms').child($code).child('members').child(auth.uid).exists() && (root.child('rooms').child($code).child('meta').child('status').val() === 'riding' || root.child('rooms').child($code).child('meta').child('status').val() === 'ending') && data.child('finished').val() !== true",
          ".validate": "newData.hasChildren(['distanceMeters','movingTimeMs','maxSpeedMps','sampleCount','startedAt','updatedAt']) && (newData.child('finished').val() !== true || newData.hasChild('endedAt'))",
          "distanceMeters": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "movingTimeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
          "maxSpeedMps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
          "topSpeedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "sampleCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "lastLatitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lastLongitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "lastSampleAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "finished": { ".validate": "newData.isBoolean() && (newData.val() === false || root.child('rooms').child($code).child('meta').child('status').val() === 'ending')" },
          "endedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "rideRoutes": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && root.child('rooms').child($code).child('members').child(auth.uid).exists() && (root.child('rooms').child($code).child('meta').child('status').val() === 'riding' || root.child('rooms').child($code).child('meta').child('status').val() === 'ending') && root.child('rideStats').child($code).child($uid).child('finished').val() !== true",
          ".validate": "newData.hasChildren(['polyline','updatedAt'])",
          "polyline": { ".validate": "newData.isString() && newData.val().length <= 60000" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "$other": { ".validate": false }
        }
      }
    },
    "rideSummaries": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostUid').val() === auth.uid && root.child('rooms').child($code).child('meta').child('status').val() === 'ending' && !data.exists()",
        ".validate": "newData.hasChildren(['roomName','hostUid','mode','group','riders'])",
        "roomName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "hostUid": { ".validate": "newData.isString() && newData.val() === root.child('rooms').child($code).child('meta').child('hostUid').val()" },
        "mode": { ".validate": "newData.val() === 'guided' || newData.val() === 'free'" },
        "group": {
          ".validate": "newData.hasChildren(['totalDistanceMeters','durationMs','averageSpeedMps','maxSpeedMps','longestDistanceMeters','riderCount','startedAt','endedAt'])",
          "totalDistanceMeters": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
          "durationMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000" },
          "averageSpeedMps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
          "maxSpeedMps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
          "longestDistanceMeters": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "riderCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
          "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "endedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        },
        "riders": {
          "$riderUid": {
            ".validate": "newData.hasChildren(['isHost','distanceMeters','movingTimeMs','averageSpeedMps','maxSpeedMps','sampleCount','finished'])",
            "displayName": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "colorId": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "isHost": { ".validate": "newData.isBoolean()" },
            "distanceMeters": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "movingTimeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
            "averageSpeedMps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
            "maxSpeedMps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
            "topSpeedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "sampleCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "endedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "finished": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "liveLocations": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && (!newData.exists() || (root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('meta').child('status').val() === 'riding'))",
          ".validate": "newData.hasChildren(['latitude','longitude','heading','speed','lastUpdated'])",
          "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "heading": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360" },
          "speed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
          "lastUpdated": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
